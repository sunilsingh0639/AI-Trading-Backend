# ── News Providers ──────────────────────────────────────────────────────────
BENZINGA_API_KEY=
MARKETAUX_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
NEWS_API_KEY=

# ── Provider Behaviour ───────────────────────────────────────────────────────
NEWS_PROVIDER_TIMEOUT_SECONDS=10
NEWS_PROVIDER_FAILURE_THRESHOLD=3
NEWS_PROVIDER_COOLDOWN_SECONDS=60

# ── NewsAPI ──────────────────────────────────────────────────────────────────
NEWS_API_COUNTRY=in

# ── AI / Groq ────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# ── Pipeline ─────────────────────────────────────────────────────────────────
MIN_IMPORTANCE_SCORE=35
MIN_SIGNAL_CONFIDENCE=55
REQUIRE_TECHNICAL_ALIGNMENT=false

# ── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=3

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/trading

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
